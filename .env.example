# Copy to .env and fill in. Every value is optional.

# Enables the AI coach (learning path and statement rewrites).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Tried in order until one responds
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_UPLOAD_MB=5
MAX_BATCH_FILES=25
LOG_LEVEL=INFO

# Where past analyses are stored
HISTORY_DB=data/history.db
