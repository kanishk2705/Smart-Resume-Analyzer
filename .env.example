# Copy to .env and fill in. Every value is optional.

# Enables the AI learning-path feature. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tried in order until one responds
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash-exp,gemini-1.5-flash

EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_UPLOAD_MB=5
LOG_LEVEL=INFO

# Where past analyses are stored
HISTORY_DB=data/history.db
MAX_BATCH_FILES=25
